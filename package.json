{
  "name": "snowline-mcp",
  "version": "2.0.0",
  "description": "Model Context Protocol server exposing Snowline's Avalanche ecosystem intelligence API to AI agents, IDEs and autonomous agents.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "snowline-mcp": "dist/index.js"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke.mjs",
    "validate:plugin": "node scripts/validate-plugin.mjs",
    "prepublishOnly": "npm run build"
  },
  "homepage": "https://www.snowlineapp.xyz/mcp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/frey-web3/snowline-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/frey-web3/snowline-mcp/issues"
  },
  "keywords": [
    "snowline",
    "avalanche",
    "mcp",
    "model-context-protocol",
    "avax",
    "ai-agents",
    "web3",
    "defi"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
